/* Professional finish for the existing DebugAI homepage. */
:root,
[data-theme="dark"] {
  --font-code: "JetBrains Mono", "SF Mono", Consolas, monospace;
  --font-ui: "Manrope", Inter, ui-sans-serif, system-ui, sans-serif;
  --space-xs: 0.5rem;
  --space-sm: 0.875rem;
  --space-md: 1.5rem;
  --space-lg: 2.25rem;
  --space-xl: 3.5rem;
  --radius: 12px;
  --radius-sm: 8px;
  --radius-lg: 16px;
  --ease: cubic-bezier(0.2, 0.75, 0.25, 1);
  --transition: 0.2s var(--ease);

  --bg: #17231d;
  --surface: #1e2b25;
  --surface-raised: #26352e;
  --border: rgba(223, 239, 224, 0.13);
  --border-strong: rgba(182, 220, 188, 0.28);
  --text: #edf3eb;
  --text-dim: #bfcec2;
  --text-faint: #8c9d90;
  --accent-amber: #e3c06c;
  --accent-cyan: #8fc6c2;
  --accent-red: #df9387;
  --accent-green: #8bc6a0;
  --accent-amber-soft: rgba(227, 192, 108, 0.12);
  --accent-cyan-soft: rgba(143, 198, 194, 0.12);
  --accent-red-soft: rgba(223, 147, 135, 0.12);
  --accent-green-soft: rgba(139, 198, 160, 0.12);
  --glow-green: 0 8px 24px rgba(0, 0, 0, 0.2);
  --glow-green-sm: 0 0 0 3px rgba(139, 198, 160, 0.16);
  --glow-red: 0 0 0 3px rgba(223, 147, 135, 0.18);
}

[data-theme="light"] {
  color-scheme: light;
  --bg: #f5f2e9;
  --surface: #fffefa;
  --surface-raised: #f0eee5;
  --border: #dedbcf;
  --border-strong: #b7c5b8;
  --text: #202b36;
  --text-dim: #56635f;
  --text-faint: #7b8982;
  --accent-amber: #bb8722;
  --accent-cyan: #287b85;
  --accent-red: #b74842;
  --accent-green: #176c4a;
  --accent-amber-soft: rgba(187, 135, 34, 0.1);
  --accent-cyan-soft: rgba(40, 123, 133, 0.09);
  --accent-red-soft: rgba(183, 72, 66, 0.09);
  --accent-green-soft: rgba(23, 108, 74, 0.09);
  --glow-green: 0 12px 32px rgba(32, 43, 54, 0.09);
  --glow-green-sm: 0 0 0 3px rgba(23, 108, 74, 0.12);
  --glow-red: 0 0 0 3px rgba(183, 72, 66, 0.12);
}

html {
  scroll-padding-top: 5.5rem;
}

body {
  background: var(--bg);
  font-size: 15px;
  line-height: 1.65;
}

body::before {
  opacity: 0.18;
  background-image:
    linear-gradient(rgba(50, 100, 72, 0.045) 1px, transparent 1px),
    linear-gradient(90deg, rgba(50, 100, 72, 0.045) 1px, transparent 1px);
  mask-image: radial-gradient(ellipse 80% 48% at 50% 0%, black 20%, transparent 95%);
}

[data-theme="light"] body::before {
  opacity: 0.11;
}

.scanline {
  display: none;
}

#matrix-rain {
  opacity: 0.5;
}

[data-theme="light"] #matrix-rain {
  opacity: 0.3;
}

.nav {
  padding: 0.9rem max(24px, calc((100vw - 1160px) / 2));
  background: color-mix(in srgb, var(--bg) 92%, transparent);
  backdrop-filter: blur(14px);
  border-bottom-color: var(--border);
}

.wordmark {
  align-items: center;
  gap: 0.65rem;
  text-decoration: none;
}

.wordmark-glyph {
  text-shadow: none;
  font-size: 1rem;
}

.wordmark-text {
  color: var(--text);
  font-family: var(--font-ui);
  font-size: 1rem;
  font-weight: 800;
  letter-spacing: -0.04em;
}

.nav-links {
  gap: clamp(0.8rem, 2.5vw, 2rem);
}

.nav-link {
  font-size: 0.82rem;
  font-weight: 600;
}

.nav-cta {
  border-radius: 7px;
  background: var(--accent-green);
  color: var(--bg);
  font-size: 0.8rem;
  font-weight: 700;
  padding: 0.65rem 1rem;
}

.nav-cta:hover {
  border-color: var(--accent-green);
  box-shadow: var(--glow-green-sm);
}

.hero {
  max-width: 1160px;
  padding: clamp(4.5rem, 9vw, 7.5rem) 24px 4.25rem;
  grid-template-columns: minmax(0, 1fr) minmax(360px, 0.82fr);
  align-items: center;
  gap: clamp(2rem, 7vw, 6rem);
}

.hero::before {
  width: 760px;
  height: 760px;
  background: radial-gradient(circle, rgba(23, 108, 74, 0.09), transparent 68%);
}

.hero-eyebrow {
  font: 600 0.72rem/1.4 var(--font-code);
  letter-spacing: 0.1em;
  text-transform: uppercase;
  margin-bottom: 1.1rem;
}

.hero-heading {
  max-width: 17ch;
  font-family: var(--font-ui);
  font-size: clamp(2.5rem, 5.1vw, 4.4rem);
  font-weight: 700;
  letter-spacing: -0.065em;
  line-height: 1.08;
}

.glitch::before,
.glitch::after {
  display: none;
}

.hero-sub {
  max-width: 54ch;
  color: var(--text-dim);
  font-size: 1rem;
  line-height: 1.8;
}

.hero-actions {
  gap: 0.7rem;
}

.hero-primary,
.hero-secondary {
  border-radius: 7px;
  font-family: var(--font-ui);
  font-size: 0.83rem;
  font-weight: 700;
}

.hero-primary {
  background: var(--accent-green);
  border-color: var(--accent-green);
  color: var(--bg);
  padding: 0.8rem 1.1rem;
}

.hero-primary:hover {
  box-shadow: var(--glow-green);
}

.hero-secondary {
  border-color: var(--border);
  background: var(--surface);
  color: var(--text-dim);
  padding: 0.75rem 0.9rem;
}

.hero-secondary:hover {
  border-color: var(--border-strong);
  color: var(--text);
  box-shadow: var(--glow-green-sm);
}

.terminal {
  border: 1px solid var(--border);
  border-radius: 12px;
  background: var(--surface);
  box-shadow: 0 24px 60px rgba(20, 35, 27, 0.14);
  transform: none;
}

.terminal-bar {
  background: var(--surface-raised);
  border-bottom-color: var(--border);
}

.terminal-body {
  min-height: 148px;
  padding: 1.25rem 1.5rem;
}

.steps,
.log,
.triangle,
.closure,
.examples,
.challenge,
.links,
.workspace {
  max-width: 1160px;
}

.steps,
.log,
.triangle,
.closure,
.examples,
.challenge,
.links {
  padding-inline: 24px;
}

.steps-title,
.log-title,
.examples-title,
.triangle-title,
.closure-title,
.challenge-title,
.links-title {
  color: var(--text);
  font-family: var(--font-ui);
  font-size: clamp(1.55rem, 3vw, 2rem);
  font-weight: 700;
  letter-spacing: -0.045em;
}

.steps-title::before,
.log-title::before,
.examples-title::before,
.triangle-title::before,
.closure-title::before,
.challenge-title::before,
.links-title::before {
  width: 1.55rem;
  height: 2px;
  border-radius: 2px;
  background: var(--accent-green);
  box-shadow: none;
}

.step,
.log-entry,
.link-card,
.panel,
.result-card,
.code-window {
  border-radius: var(--radius);
}

.step,
.log-entry,
.link-card {
  background: var(--surface);
  border-color: var(--border);
  box-shadow: 0 8px 22px rgba(31, 44, 36, 0.035);
}

.step:hover,
.log-entry:hover,
.link-card:hover {
  border-color: var(--border-strong);
  box-shadow: var(--glow-green);
  transform: translateY(-2px);
}

.step-prompt,
.section-lead,
.step-desc,
.log-text span,
.showcase-readout,
.examples-caption {
  font-family: var(--font-ui);
}

.step-prompt {
  color: var(--accent-green);
  font-size: 0.73rem;
  font-weight: 700;
}

.step-list {
  display: grid;
  gap: 0.7rem;
  overflow: visible;
}

.step {
  margin-left: 1rem;
  padding: 0.9rem 1rem 0.9rem 1.25rem;
  border: 1px solid var(--border);
}

.step:last-child {
  padding-bottom: 0.9rem;
}

.step::before {
  left: calc(-1rem - 4.5px);
  top: 1.25rem;
}

.log {
  overflow: visible;
}

.log-entry {
  margin: 0;
  padding: 1rem 1.15rem;
  border: 1px solid var(--border);
}

.log-entry + .log-entry {
  margin-top: 0.7rem;
}

.log-entry:last-child {
  border-bottom: 1px solid var(--border);
}

.log-text strong,
.panel-label,
.result-title {
  font-family: var(--font-ui);
}

.triangle,
.closure,
.challenge {
  border-top-color: var(--border);
  border-bottom-color: var(--border);
}

.workspace {
  padding: clamp(3.5rem, 7vw, 5.5rem) 24px;
}

.tool-title {
  color: var(--text);
  font-family: var(--font-ui);
  font-size: 1.3rem;
  font-weight: 700;
  letter-spacing: -0.04em;
}

.debug-form {
  gap: 1rem;
}

.panel {
  border-color: var(--border);
  background: var(--surface);
  padding: clamp(1rem, 2.2vw, 1.5rem);
  box-shadow: 0 10px 28px rgba(31, 44, 36, 0.035);
}

.panel:focus-within {
  border-color: var(--border-strong);
  box-shadow: var(--glow-green-sm);
}

.panel-scan {
  display: none;
}

.panel-head {
  margin-bottom: 0.75rem;
}

.panel-label {
  font-size: 0.9rem;
  font-weight: 700;
}

.panel-hint {
  font-size: 0.72rem;
}

.field {
  border-radius: 7px;
  border-color: var(--border);
  background: var(--surface-raised);
  font-size: 0.9rem;
}

.field--code {
  font-size: 0.82rem;
  line-height: 1.7;
}

.field:focus {
  box-shadow: var(--glow-green-sm);
}

.submit-row {
  border-top: 1px solid var(--border);
  padding-top: 1.1rem;
}

.submit-button {
  border: 1px solid var(--accent-green);
  border-radius: 7px;
  background: var(--accent-green);
  color: var(--bg);
  font-family: var(--font-ui);
  font-size: 0.85rem;
  font-weight: 800;
  padding: 0.85rem 1.25rem;
  box-shadow: none;
}

.submit-button:hover {
  box-shadow: var(--glow-green);
  transform: translateY(-1px);
}

.submit-note {
  max-width: 60ch;
  font-family: var(--font-ui);
}

.result-card {
  border-left-width: 3px;
  box-shadow: none;
  animation: none;
}

.result-card--bug {
  border-left-color: var(--accent-red);
}

.result-card--why {
  border-left-color: var(--accent-cyan);
}

.result-card--fix {
  border-left-color: var(--accent-green);
}

.result-title {
  font-size: 1rem;
}

.result-prose {
  font-family: var(--font-ui);
}

.code-window {
  overflow: hidden;
  border: 1px solid var(--border);
}

.code-window-bar {
  background: var(--surface-raised);
  border-bottom-color: var(--border);
}

.apply-fix-button {
  border-radius: 7px;
  background: var(--accent-green);
  color: var(--bg);
  font-family: var(--font-ui);
  font-weight: 700;
}

.links {
  padding-bottom: 4rem;
}

.site-footer {
  border-top: 1px solid var(--border);
  padding-top: 1.5rem;
}

a,
button,
textarea {
  transition-duration: 0.18s;
}

:focus-visible {
  outline: 3px solid color-mix(in srgb, var(--accent-cyan) 65%, transparent);
  outline-offset: 3px;
}

@media (max-width: 700px) {
  .nav {
    padding-inline: 18px;
  }

  .hero {
    padding: 3.75rem 18px 3.5rem;
  }

  .hero-heading {
    font-size: clamp(2.25rem, 10vw, 3.3rem);
  }

  .steps,
  .log,
  .triangle,
  .closure,
  .examples,
  .challenge,
  .links,
  .workspace {
    padding-inline: 18px;
  }
}

@media (max-width: 900px) {
  .hero {
    grid-template-columns: minmax(0, 1fr);
  }

  .terminal {
    width: 100%;
  }
}

@media (max-width: 480px) {
  .nav {
    padding: 0.8rem 14px;
  }

  .nav-links {
    gap: 0.55rem;
  }

  .nav-link {
    font-size: 0.72rem;
  }

  .nav-cta {
    padding: 0.55rem 0.7rem;
    font-size: 0.72rem;
  }

  .hero-actions {
    align-items: stretch;
  }

  .hero-primary,
  .hero-secondary {
    padding: 0.72rem 0.75rem;
  }

  .terminal-body {
    padding-inline: 1rem;
  }
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}

/* The existing About, legal, game, and not-found pages share this system. */
.about-hero,
.hunt-hero {
  max-width: 900px;
  padding: clamp(4rem, 8vw, 6rem) 24px 2rem;
}

.about-hero {
  text-align: left;
}

.about-hero .hero-sub {
  margin: 1rem 0 0;
}

.hunt-hero {
  text-align: center;
}

.about-section {
  max-width: 900px;
  padding: 2rem 24px 2.5rem;
  border-top-color: var(--border);
}

.about-section-title {
  gap: 0.75rem;
  margin-bottom: 1rem;
  color: var(--text);
  font-family: var(--font-ui);
  font-size: 1.1rem;
  font-weight: 700;
  letter-spacing: -0.03em;
}

.about-section-title::before {
  content: "";
  width: 1.5rem;
  height: 2px;
  border-radius: 2px;
  background: var(--accent-green);
}

.about-prose,
.legal-list {
  font-family: var(--font-ui);
  font-size: 0.94rem;
  line-height: 1.8;
}

.about-link {
  color: var(--accent-green);
  font-weight: 600;
  text-decoration-thickness: 1px;
}

.about-link:hover {
  color: var(--accent-cyan);
}

.about-card,
.legal-card {
  border-color: var(--border);
  border-radius: var(--radius);
  box-shadow: 0 8px 22px rgba(31, 44, 36, 0.035);
}

.about-card:hover,
.legal-card:hover {
  border-color: var(--border-strong);
  box-shadow: var(--glow-green);
}

.about-card-dot {
  box-shadow: none;
}

.about-card h3,
.legal-card h3 {
  font-family: var(--font-ui);
  font-size: 0.95rem;
  font-weight: 700;
}

.about-card p,
.legal-card ul {
  font-family: var(--font-ui);
  font-size: 0.88rem;
  line-height: 1.75;
}

.legal-card {
  background: var(--surface);
}

.legal-license-text {
  border-radius: 10px;
  font-size: 0.78rem;
  line-height: 1.75;
}

.hunt {
  width: min(calc(100% - 48px), 760px);
  margin-bottom: 4rem;
  padding: clamp(1rem, 3vw, 1.75rem);
  border-radius: 14px;
  box-shadow: 0 14px 36px rgba(31, 44, 36, 0.07);
}

.hunt-rank {
  font-family: var(--font-code);
  font-size: 0.72rem;
}

.hunt-stats {
  gap: 0.65rem;
}

.hunt-stat {
  padding: 0.8rem 0.5rem;
  border: 1px solid var(--border);
  border-radius: 9px;
  background: var(--surface-raised);
}

.hunt-stat-value {
  font-family: var(--font-ui);
  font-weight: 800;
}

.hunt-grid {
  gap: 0.65rem;
}

.hole {
  border-radius: 12px;
  box-shadow: 0 5px 14px rgba(31, 44, 36, 0.04);
}

.hole:hover:not(.is-active) {
  border-color: var(--border-strong);
}

.hunt-status {
  font-family: var(--font-ui);
}

.not-found {
  width: min(calc(100% - 48px), 760px);
  max-width: 760px;
  padding: clamp(4.5rem, 11vw, 8rem) 24px;
  text-align: left;
}

.not-found-code {
  color: var(--accent-green);
  font-family: var(--font-ui);
  font-size: clamp(5rem, 18vw, 8rem);
  font-weight: 800;
  letter-spacing: -0.09em;
}

.not-found-console {
  border-radius: 12px;
  background: var(--surface);
  box-shadow: 0 12px 30px rgba(31, 44, 36, 0.06);
}

.site-footer {
  max-width: 950px;
  padding-right: 24px;
  padding-left: 24px;
}

@media (max-width: 700px) {
  .about-hero,
  .hunt-hero,
  .about-section,
  .site-footer {
    padding-right: 18px;
    padding-left: 18px;
  }

  .about-section {
    padding-top: 1.6rem;
    padding-bottom: 2rem;
  }

  .hunt {
    width: calc(100% - 36px);
  }

  .not-found {
    width: calc(100% - 36px);
    padding: 4.5rem 18px;
  }
}
